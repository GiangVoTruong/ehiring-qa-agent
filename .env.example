# Copy thành .env (không commit). Tài khoản QA staging — người duyệt/được giao trong test luôn là tài khoản này.
BASE_URL=https://shinhanbank.stg.talentx.vn
QA_USERNAME=
QA_PASSWORD=
# Chỉ cần nếu Keycloak đòi OTP (base32)
QA_TOTP_SECRET=

# AI khi chạy lại (tự sửa phần tử, tự điền ô mới). Đặt giá trị trên server/.env, KHÔNG commit. Bỏ trống = tắt AI.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# QA_AI=0        # tắt AI dù có key
# QA_AI_IMAGE=0  # không gửi ảnh chụp trang khi tự sửa

# Demo trên máy cá nhân, không cần key: QA_AI_CLI=1 (dùng Claude Code đã đăng nhập; QA_AI_CLI_MODEL=haiku|sonnet|opus)
# Tài khoản đăng nhập bằng form local của app (không qua Sign in with SSO)
# QA_LOGIN_LOCAL=1
